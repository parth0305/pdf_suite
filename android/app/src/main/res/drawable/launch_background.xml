<?xml version="1.0" encoding="utf-8"?>
<!-- Folio's launch window. The default template was plain white, which reads
     as a blank screen while the engine starts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/folio_splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
