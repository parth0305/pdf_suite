<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8 and later mask the launcher icon to whatever shape the launcher
  wants. Without this file it does that to the finished iOS-style artwork,
  rounded corners and all, which is why the icon looked wrong beside the iPhone
  one: a rounded square trimmed into a circle, floating on a background the
  launcher chose.

  The monochrome layer is what Android 13's themed icons use. Without it the
  launcher falls back to shrinking the full icon onto a grey plate.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
